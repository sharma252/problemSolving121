#include<bits/stdc++.h>
using namespace std;

// Recursive helper function with memoization to find the length of the Longest Increasing Subsequence (LIS)
int helper(vector<int> &nums, int idx, int prevIdx, vector<vector<int>> &mem) {
    // Base case: If we've checked all elements, return 0
    if (idx == nums.size()) return 0;

    // If the result is already computed, return it (memoization)
    if (mem[idx][prevIdx + 1] != -1) return mem[idx][prevIdx + 1];

    // Option 1: Skip the current element
    int notTake = helper(nums, idx + 1, prevIdx, mem);

    int take = 0;
    // Option 2: Take the current element if it's greater than or equal to the previous one in the subsequence
    if (prevIdx == -1 || nums[prevIdx] <= nums[idx]) {
        take = 1 + helper(nums, idx + 1, idx, mem);
    }

    // Store and return the maximum of taking or not taking the current element
    return mem[idx][prevIdx + 1] = max(take, notTake);
}

// Recursive helper function *without* memoization (for comparison or brute-force reference)
int helper(vector<int> &nums, int idx, int prevIdx) {
    // Base case: All elements considered
    if (idx == nums.size()) return 0;

    // Option 1: Skip the current element
    int notTake = helper(nums, idx + 1, prevIdx);

    int take = 0;
    // Option 2: Include current element if it continues the increasing subsequence
    if (prevIdx == -1 || nums[prevIdx] <= nums[idx]) {
        take = 1 + helper(nums, idx + 1, idx);
    }

    // Return the best of both options
    return max(take, notTake);
}

// Main function to compute the LIS length using memoized recursion
int lis(vector<int> &nums) {
    int idx = 0;
    int prevIdx = -1;

    // Create a memoization table initialized to -1
    // Note: We use (prevIdx + 1) to handle the case where prevIdx is -1
    vector<vector<int>> mem(nums.size(), vector<int>(nums.size() + 1, -1));

    // Use the memoized version of helper
    return helper(nums, idx, prevIdx, mem);
}


int lisDP(vector<int> &nums){
int n = nums.size();
    if (n == 0) return 0; // Handle empty vector case
    
    vector<int> dp(n, 1);

    for (int end_idx = 0; end_idx < n; ++end_idx) {
        // Look back at all previous elements to find one that can extend an increasing subsequence.
        for (int prev_idx = 0; prev_idx < end_idx; ++prev_idx) {
            // extention is only possible if curEle > prevEle
            if (nums[end_idx] > nums[prev_idx]) {
                dp[end_idx] = max(dp[end_idx], dp[prev_idx] + 1);   //update length.
            }
        }
    }

    // The length of the LIS is the max value in dp array
    return *max_element(dp.begin(), dp.end());
}

int main(){
    vector<int> arr = {10,9,2,5,3,7,101,18};
    
    cout<<lis(arr)<<endl;
    cout<<lisDP(arr)<<endl;

    return 0;
}
