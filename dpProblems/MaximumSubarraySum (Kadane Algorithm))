#include<bits/stdc++.h>
using namespace std;

// 1. Recursion
// Helper: Returns the max subarray sum ending at index 'idx'
int maxEndingAt(vector<int> &nums, int idx) {
    if (idx == 0) return nums[0];

    int startNewSubarray = nums[idx];
    int extendPreviousSubarray = maxEndingAt(nums, idx - 1) + nums[idx];

    return max(startNewSubarray, extendPreviousSubarray);
}


int maxSubArrayBruteForce(vector<int>& nums) {
    int n = nums.size();
    int maxSum = INT_MIN;

    for (int i = 0; i < n; i++) {
        maxSum = max(maxSum, maxEndingAt(nums, i));
    }

    return maxSum;
}

//2. memoization:
int helper(int idx, vector<int>& nums, vector<int>& mem) {
    if (idx == 0) return mem[0] = nums[0];
    if (mem[idx] != INT_MIN) return mem[idx];

    int startNewSubarray = nums[idx];
    int extendPreviousSubarray = maxEndingAt(nums, idx - 1) + nums[idx];

    mem[idx] = max(startNewSubarray,extendPreviousSubarray );
    return mem[idx];
}

int maxSubArrayMem(vector<int>& nums) {
    int n = nums.size();
    vector<int> mem(n, INT_MIN);

    int maxSum = INT_MIN;
    for (int itr = 0; itr < n; itr++) {
        maxSum = max(maxSum, helper(itr, nums, mem));
    }
    return maxSum;
}


// 3. Tabulation (Bottom-Up)
int maxSubArrayDP(vector<int>& nums) {
    int n = nums.size();
    vector<int> dp(n);
    dp[0] = nums[0];

    int maxSum = INT_MIN;
    for (int i = 1; i < n; i++) {
        dp[i] = max(nums[i], nums[i] + dp[i - 1]);
        maxSum = max(maxSum, dp[i]);
    }
    return maxSum;
}

// 5. Kadane's Algorithm (O(1) space)
int kadane(vector<int>& nums) {
    int maxSum=nums[0];
    int curSum=nums[0];

    for(int itr=1;itr<nums.size();itr++){
        int startNewSubarray = nums[itr];
        int extendPreviousSubarray = curSum + nums[itr];
        curSum = max(startNewSubarray,extendPreviousSubarray);

        maxSum = max(maxSum,curSum);
    }

    return maxSum;
}

int kadaneWithSubarray(vector<int>& nums) {
    int maxSum = nums[0];
    int curSum = nums[0];
    int startIdx = 0, endIdx = 0, tempStart = 0;

    for (int i = 1; i < nums.size(); ++i) {
        if (curSum + nums[i] < nums[i]) {
            curSum = nums[i];
            tempStart = i;
        } else {
            curSum += nums[i];
        }

        if (curSum > maxSum) {
            maxSum = curSum;
            startIdx = tempStart;
            endIdx = i;
        }
    }

    // If you need to return the subarray:
    // vector<int> subarray(nums.begin() + startIdx, nums.begin() + endIdx + 1);
    return maxSum;
}

